# Copy to .env and fill in. Never commit .env.

# AWS / S3 (shared raw-data bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# ClickHouse
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=agrocycle

# NASA Earthdata (needed from Phase 1, HLS)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Copy to .env and fill in. Never commit .env.

# AWS / S3 (shared raw-data bucket)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET=

# ClickHouse
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=agrocycle

# NASA Earthdata (needed from Phase 1, HLS)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# API (all optional; defaults shown)
# AGROCYCLE_DATA_SOURCE=files            # "files" (committed data + data/out/indicators) or "clickhouse"
# AGROCYCLE_CORS_ORIGINS=http://localhost:3004
# AGROCYCLE_ALLOW_SAMPLE_PREVIEW=true    # demo only: lets a request use sample indicator values
# AGROCYCLE_INDICATORS_DIR=data/out/indicators   # where DS2's runner wrote field_indicators.csv
